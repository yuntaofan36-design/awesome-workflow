# Copy to .env and replace every change-me value before using the stack.
# Compose applies the checked-in API migrations before starting the API.

# Runtime mode and browser-visible endpoints
NODE_ENV=development
API_PORT=4100
API_PUBLIC_URL=http://localhost:4100
WEB_PUBLIC_URL=http://localhost:4300
API_ORIGINS=http://localhost:4300,http://localhost:4302,tauri://localhost,http://tauri.localhost

# API persistence. Host-facing values are shown here; Compose replaces them
# with postgres/redis service DNS names inside the containers.
REPOSITORY_MODE=postgres
POSTGRES_USER=awesome_workflow
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://awesome_workflow:change-me-postgres-password@localhost:5432/awesome_workflow
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# API session and hybrid authentication. Email OTP is issued by the BFF and
# delivered over SMTP; Logto is used only for configured social providers.
SESSION_SECRET=change-me-session-secret-at-least-32-characters
OTP_PEPPER=change-me-otp-pepper-at-least-32-characters
AUTH_MODE=hybrid
AUTH_DEV_EXPOSE_OTP=false
EMAIL_DELIVERY=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@awesome-workflow.local
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=
BOOTSTRAP_ADMIN_EMAILS=admin@example.com

# MinIO has two deliberate addresses. Containers use MINIO_INTERNAL_ENDPOINT
# for service-to-service administration. Browser upload URLs use the published
# minio.localhost address. Worker downloads use the internal service address.
MINIO_ROOT_USER=awesome-workflow-local
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_INTERNAL_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://minio.localhost:9000
ARTIFACT_BUCKET=awesome-workflow-artifacts
ARTIFACT_UPLOAD_BASE_URL=http://minio.localhost:9000/awesome-workflow-artifacts
S3_REGION=us-east-1

# Logto is the social OIDC authority. Google, Feishu and WeChat connector
# credentials belong to Logto, never to this platform API. Database seeding
# does not create the OIDC application or any Connector.
LOGTO_IMAGE=svhd/logto:1.31.0
LOGTO_PORT=3001
LOGTO_ADMIN_PORT=3002
LOGTO_PUBLIC_ENDPOINT=http://logto.localhost:3001
LOGTO_ADMIN_ENDPOINT=http://localhost:3002
OIDC_ISSUER=http://logto.localhost:3001/oidc
OIDC_CLIENT_ID=change-me-logto-web-app-id
OIDC_CLIENT_SECRET=change-me-logto-web-app-secret
OIDC_REDIRECT_URI=http://localhost:4100/api/v1/auth/oidc/callback
OIDC_POST_LOGIN_REDIRECT=http://localhost:4300/
# Keep this empty until each real Logto Connector is configured and tested.
OIDC_ENABLED_PROVIDERS=
# Exact-match, generic workload OIDC trust policies. Keep [] until CI identity
# issuer/audience/JWKS/subject and a dedicated principal email are approved.
WORKLOAD_OIDC_POLICIES=[]

# Web build-time configuration
WEB_SHELL_PORT=4300
CONTROL_PLANE_PORT=4302
VITE_API_BASE_URL=http://localhost:4100/api/v1
VITE_CONTROL_PLANE_MANIFEST_URL=http://localhost:4302/mf-manifest.json
VITE_DEMO_IFRAME_URL=
VITE_TRUSTED_FEDERATION_ORIGINS=http://localhost:4302
VITE_WORKSPACE_ID=

# Desktop release updater trust configuration. These are build-time public
# values, not runtime overrides. Keep the signing private key in CI secrets.
AW_DESKTOP_UPDATER_ENDPOINT=https://updates.example.com/awesome-workflow/{{target}}/{{arch}}/{{current_version}}
AW_DESKTOP_UPDATER_PUBLIC_KEY=change-me-tauri-updater-public-key

# Worker validation policy
WORKER_API_BASE_URL=http://localhost:4100
WORKER_CALLBACK_TOKEN=change-me-worker-callback-token-at-least-32-characters
RELEASE_SIGNING_PUBLIC_KEYS=change-me-key-id=change-me-raw-base64-public-key
# API-generated Worker download URLs use the internal S3 endpoint.
ARTIFACT_ALLOWED_ORIGINS=http://minio:9000
ARTIFACT_MAX_BYTES=268435456
ARTIFACT_MAX_FILES=10000
ARTIFACT_MAX_EXPANDED_BYTES=1073741824
SBOM_MAX_BYTES=16777216

# Supporting local ports and observability
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
OTEL_EXPORTER_OTLP_ENDPOINT=
