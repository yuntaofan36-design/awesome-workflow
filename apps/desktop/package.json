{
  "name": "@awesome-workflow/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "vite --port 4303 --strictPort",
    "build": "pnpm build:web",
    "build:web": "tsc -b && vite build",
    "prepare:native": "cargo build -p awesome-workflow-agent -p awesome-workflow-runner",
    "build:native-sidecars": "cargo build --release -p awesome-workflow-agent -p awesome-workflow-runner -p awesome-workflow-elevated-helper && node ./scripts/stage-sidecars.mjs release",
    "build:desktop": "pnpm build:web && pnpm build:native-sidecars",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "configure:updater": "node ./scripts/write-updater-config.mjs",
    "tauri:build": "pnpm configure:updater && pnpm build:native-sidecars && tauri build --config src-tauri/tauri.release.conf.json",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@arco-design/web-react": "^2.66.0",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-process": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "catalog:",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "@tauri-apps/cli": "^2.5.0",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.31.0",
    "vite": "^7.0.0"
  }
}
